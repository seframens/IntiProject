<Window x:Class="ProjectChecking.Wpf.Views.Dialogs.ActivityEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вид деятельности"
        Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="Новый вид деятельности" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="Название"/>
            <TextBox x:Name="NameBox"/>
            <TextBlock Text="Квалификация руководителя"/>
            <ComboBox x:Name="QualificationBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="OnCancel"/>
            <Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
