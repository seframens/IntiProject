<Window x:Class="ProjectChecking.Wpf.Views.Dialogs.LeaderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Руководитель"
        Height="550" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="Новый руководитель" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="{StaticResource PrimaryBrush}"/>

        <TextBlock Grid.Row="1" Text="ФИО"/>
        <TextBox Grid.Row="2" x:Name="FullNameBox"/>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Квалификации"/>
            <ListBox x:Name="QualList" Height="240" SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Tag="{Binding Id}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="OnCancel"/>
            <Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
