<Window x:Class="ProjectChecking.Wpf.Views.Dialogs.WorkerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Работник"
        Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="Новый работник" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="ФИО"/>
            <TextBox x:Name="FullNameBox"/>
            <TextBlock Text="Статус"/>
            <ComboBox x:Name="StatusBox">
                <ComboBoxItem Content="свободен"/>
                <ComboBoxItem Content="занят"/>
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="OnCancel"/>
            <Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
