<Window x:Class="ProjectChecking.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт проектов"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackground}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Учёт проектов" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button Content="Выйти" Style="{StaticResource SecondaryButton}" Click="OnLogout"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Width="220" Background="#FAFBFC" BorderBrush="#E2E7EC" BorderThickness="0,0,1,0">
            <StackPanel x:Name="MenuPanel" Margin="8"/>
        </Border>

        <ContentControl x:Name="MainContent" Margin="0"/>
    </DockPanel>
</Window>
