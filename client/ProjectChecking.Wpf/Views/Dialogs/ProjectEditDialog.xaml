<Window x:Class="ProjectChecking.Wpf.Views.Dialogs.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проект"
        Height="700" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Text="Новый проект" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="{StaticResource PrimaryBrush}"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Тема (вид деятельности)"/>
            <ComboBox x:Name="ActivityBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="OnActivityChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Заказчик"/>
            <TextBox x:Name="CustomerBox"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Описание"/>
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Руководитель"/>
            <ComboBox x:Name="LeaderBox" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
            <TextBlock x:Name="LeaderHint" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Text="Работники" Margin="0,8,0,4"/>

        <Border Grid.Row="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WorkersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="6,4" IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                <CheckBox.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FullName}"/>
                                        <TextBlock Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}" FontStyle="Italic">
                                            <Run Text="("/><Run Text="{Binding Status}"/><Run Text=")"/>
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="7" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="OnCancel"/>
            <Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
